{
    "ietf-mud:mud": {
      "mud-version": 1,
      "mud-url": "https://lighting.example.com/lightbulb2000",
      "last-update": "2019-01-28T11:20:51+01:00",
      "cache-validity": 48,
      "is-supported": true,
      "systeminfo": "The BMS Example Light Bulb",
      "from-device-policy": {
        "access-lists": {
          "access-list": [
            {
              "name": "mud-76100-v6fr"
            },
            {
              "name": "mud-76200-v6fr"
            }
          ]
        }
      },
      "to-device-policy": {
        "access-lists": {
          "access-list": [
            {
              "name": "mud-76100-v6to"
            },
            {
              "name": "mud-76200-v6to"
            }
          ]
        }
      }
    },
    "ietf-access-control-list:acls": {
      "acl": [
        {
          "name": "mud-76100-v6to",
          "type": "ipv6-acl-type",
          "aces": {
            "ace": [
              {
                "name": "cl0-1-todev",
                "matches": {
                  "ipv6": {
                    "ietf-acldns:src-dnsname": "test.example.com",
                    "protocol": 6
                  },
                  "tcp": {
                    "ietf-mud:direction-initiated": "from-device",
                    "source-port": {
                      "operator": "eq",
                      "port": 443
                    }
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        },
        {
          "name": "mud-76200-v6to",
          "type": "ipv6-acl-type",
          "aces": {
            "ace": [
              {
                "name": "cl0-2-todev",
                "matches": {
                  "ipv6": {
                    "ietf-acldns:src-dnsname": "test.example.com",
                    "protocol": 6
                  },
                  "tcp": {
                    "ietf-mud:direction-initiated": "from-device",
                    "source-port": {
                      "operator": "eq",
                      "port": 443
                    }
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        },
        {
          "name": "mud-76100-v6fr",
          "type": "ipv6-acl-type",
          "aces": {
            "ace": [
              {
                "name": "cl0-1-frdev",
                "matches": {
                  "ipv6": {
                    "ietf-acldns:dst-dnsname": "test.example.com",
                    "protocol": 6
                  },
                  "tcp": {
                    "ietf-mud:direction-initiated": "from-device",
                    "destination-port": {
                      "operator": "eq",
                      "port": 443
                    }
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        },
        {
          "name": "mud-76200-v6fr",
          "type": "ipv6-acl-type",
          "aces": {
            "ace": [
              {
                "name": "cl0-2-frdev",
                "matches": {
                  "ipv6": {
                    "ietf-acldns:dst-dnsname": "test.example2.com",
                    "protocol": 6
                  },
                  "tcp": {
                    "ietf-mud:direction-initiated": "from-device",
                    "destination-port": {
                      "operator": "eq",
                      "port": 445
                    }
                  }
                },
                "actions": {
                  "forwarding": "accept"
                }
              }
            ]
          }
        }
      ]
    }
  }